# Builder.io Public API Key (required for content and blog)
# Get it from https://builder.io/account/space
NEXT_PUBLIC_BUILDER_API_KEY=your_builder_io_public_api_key
NEXT_PUBLIC_ALGOLIA_APP_ID=TODO
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=TODO

# Server-only secret used to sign the httpOnly targeting session cookie.
# Generate one with: openssl rand -base64 32
# Falls back to an insecure dev value if unset — REQUIRED in production.
SESSION_SECRET=change_me_in_production